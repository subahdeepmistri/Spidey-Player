{
  "name": "spidey-player",
  "version": "2.0.0",
  "private": true,
  "description": "A cyber-glass web music player. Local-first library in IndexedDB, zero-runtime-dependency frontend.",
  "scripts": {
    "start": "npx --yes serve .",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "node test/browser-verify.js",
    "build": "npm run build:css"
  },
  "keywords": [
    "music-player",
    "web-audio-api",
    "indexeddb",
    "glassmorphism"
  ],
  "author": "Subhadeep Mistri",
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.49.1",
    "tailwindcss": "^3.4.17"
  }
}
